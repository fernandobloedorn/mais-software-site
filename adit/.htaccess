# /adit/.htaccess — Clínica Adit (ver docs/TDD-001-fase1.md §8)
# Copiado para a raiz do build via "assets" no angular.json.
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /adit/

  # 1. HTTPS obrigatório
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Fase 2: API PHP (a pasta api/ terá o próprio .htaccess)
  RewriteRule ^api/ - [L]

  # 3. Arquivo ou pasta existente → servir direto (HTML pré-renderizado, JS, CSS, imagens)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Caminho com extensão que não existe → 404 real (não servir o app para /foto.jpg)
  RewriteRule \.[a-z0-9]{2,5}$ - [R=404,L,NC]

  # 5. Demais rotas (área do cliente, rotas do Angular) → shell do CSR
  RewriteRule ^ index.csr.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Arquivos com hash no nome: 1 ano, imutáveis
  <FilesMatch "-[A-Z0-9]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML: sempre revalidar (deploy novo aparece na hora)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Content-Security-Policy: ativar depois de testada (TDD-001 §8, risco T2).
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
